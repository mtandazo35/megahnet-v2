# Configuracion de scripts/vps-sync.sh
#
# Copia este archivo a la RAIZ del repositorio con el nombre ".vps.env" y ajusta
# los valores. ".vps.env" esta en .gitignore: no se sube a git.
# Las variables de entorno tienen prioridad sobre este archivo.

# usuario@ip del VPS de pruebas (192.0.2.x es una direccion de documentacion)
VPS_HOST=root@192.0.2.10

# Carpeta de la aplicacion en el VPS
VPS_PATH=/var/www/megahnet

# Puerto SSH
VPS_PORT=22

# Dueno de lo que se envia (el usuario con el que corre Apache). Vacio = no cambiar.
VPS_OWNER=www-data:www-data

# Donde guarda el VPS los respaldos previos a cada envio
VPS_BACKUP=$HOME/vps-sync-backups
